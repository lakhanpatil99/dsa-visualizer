# ==============================================================================
# ALGOMANIA — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Dashboard for Preview and Production environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE WEB CONFIGURATION (Publicly accessible in browser)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere123456
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=algomania-dsa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=algomania-dsa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=algomania-dsa.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN CREDENTIALS (Strictly Server-Only, NEVER NEXT_PUBLIC)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=algomania-dsa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@algomania-dsa.iam.gserviceaccount.com
# Note: In Vercel or .env.local, wrap in quotes and keep literal \n or multiline string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternative: Provide entire service account JSON as single-line string (optional)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"algomania-dsa",...}

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Server-Side Only)
# MongoDB Atlas Connection URI
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://db_user:password123@cluster0.xxxxx.mongodb.net/dsa-visualizer?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. LEGACY / UTILITY (Server-Side Only)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-retained-for-legacy-migration-verification
