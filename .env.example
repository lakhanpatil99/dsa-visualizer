# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE WEB CONFIGURATION (Publicly embedded in browser bundles)
# Configure in Vercel Dashboard -> Project Settings -> Environment Variables
# Scope: Production, Preview, Development
# IMPORTANT: NEXT_PUBLIC_* variables MUST be present during build time.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere123456
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=algomania-e0d2f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=algomania-e0d2f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=algomania-e0d2f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=55337689643
NEXT_PUBLIC_FIREBASE_APP_ID=1:55337689643:web:03a03b8d1f7ad23bbb006e
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2R03XCYBFD

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN CREDENTIALS (Strictly Server-Only, NEVER NEXT_PUBLIC)
# Scope: Production, Preview (Serverless Functions)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=algomania-e0d2f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@algomania-e0d2f.iam.gserviceaccount.com
# Wrap private key in quotes and preserve literal \n sequences:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternative: Single-line JSON service account string (optional)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"algomania-e0d2f",...}

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Server-Side Only)
# MongoDB Atlas Connection URI
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://db_user:password123@cluster0.xxxxx.mongodb.net/dsa-visualizer?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. LEGACY / UTILITY (Server-Side Only)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-retained-for-legacy-migration-verification
